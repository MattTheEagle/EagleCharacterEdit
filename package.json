{
  "name": "eagle-character-edit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Eagle Character Edit: read-only character viewing and bounded player-character creation for Foundry VTT.",
  "scripts": {
    "build:v13": "esbuild v13/module.ts --bundle --format=esm --outfile=v13/dist/module.js",
    "build": "npm run build:v13",
    "typecheck:v13": "tsc -p v13/tsconfig.json",
    "typecheck": "npm run typecheck:v13",
    "test": "vitest run",
    "package": "node v13/package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
